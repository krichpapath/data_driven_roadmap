# =============================================================================
# .gitignore for the Roadmapping repo
# =============================================================================
# Track active code. Documentation and archived research stay local.
# =============================================================================

# --- Local-only folders -----------------------------------------------------
# Local handbook, verification reports, and retired research.
/docs/
/archive/

# Runtime output (may contain personal data)
logs/

# Scratch / working artifacts
tmp/

# Diagnostic dumps from tools/
tools/diagnostic_output/

# Browser-automation profile dirs created by scripts
.edge-*/

# Research PDFs land at the repo root by convention; never push them
*.pdf

# --- Python virtual environments --------------------------------------------
venv/
.venv/
.venv-*/
env/
ENV/

# --- Python build / cache artifacts -----------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Test / type-check / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage/

# Packaging
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# --- Hugging Face / model caches --------------------------------------------
# These can balloon to many GB if a download lands inside the repo by accident
.cache/
hf_cache/
**/transformers_cache/
**/huggingface/
**/models_cache/
*.bin
*.safetensors
*.pt
*.pth
*.ckpt

# --- Notebooks --------------------------------------------------------------
.ipynb_checkpoints/

# --- Local secrets / env files ----------------------------------------------
.env
.env.*
!.env.example
secrets.toml
*.key
*.pem

# --- IDE / editor noise -----------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# --- Claude / AI assistant local config -------------------------------------
.claude/
**/.claude/

# Private learning profiles and session notes; keep these on this machine.
.vibe-wise/
.sensible-vibes/

# --- OS junk ----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# --- LaTeX build artifacts (in case any leak into prototype/) ---------------
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
*.log
*.out
*.toc

# --- One-off operational scripts from the folder cleanup --------------------
# These did their job once. Untrack to keep the repo clean.
# If you want to keep them in the repo for reproducibility, comment these out.
reorganize.ps1
REORGANIZATION_PLAN.md
GIT_PUSH_GUIDE.md

# --- Personal scratch ------------------------------------------------------
FUTUREPLAN.md

# --- Frontend (Vitest) ------------------------------------------------------
# node_modules is huge and reproducible from package.json + package-lock.json.
# Lock file IS tracked so test versions stay pinned across machines.
node_modules/
**/node_modules/

# --- MkDocs build output ---------------------------------------------------
# The docs site is generated from the local docs/ folder by `mkdocs build`.
site/

# Durable roadmap history (src/api/history_store.py)
/data/
