# Copy this file to .env if you want to enable optional LLM-powered guidance.
# The application can run without this value by using deterministic fallback guidance.

OPENROUTER_API_KEY=your_openrouter_api_key_here

# Hosted guidance also requires the UI checkbox or allow_external_ai=true.
# Set off here to prohibit hosted guidance even when a request opts in.
DDRM_EXTERNAL_AI=off
OPENROUTER_MODEL=openai/gpt-6-luna
